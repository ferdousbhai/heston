{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Keeps the pre-rebrand name: renaming a Worker creates a new one, which loses its per-Worker
  // secrets (BETTER_AUTH_SECRET), its Durable Object state, the Workers Builds connection, and the
  // service binding the private long-vol Workflow uses to reach `BriefPublisher`. Durable Object
  // class names and migration tags below stay for the same reason: renaming a class needs a
  // migration and drops its state.
  "name": "heston",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "workers_dev": false,
  "preview_urls": true,
  // The retired heston.io and tryspice.xyz pairs, and www.spicy.trade, still route here so
  // `canonicalHostRedirect` can 308 them to spicy.trade; drop a retired pair when its zone is
  // allowed to lapse.
  "routes": [
    { "pattern": "spicy.trade", "custom_domain": true },
    { "pattern": "www.spicy.trade", "custom_domain": true },
    { "pattern": "heston.io", "custom_domain": true },
    { "pattern": "www.heston.io", "custom_domain": true },
    { "pattern": "tryspice.xyz", "custom_domain": true },
    { "pattern": "www.tryspice.xyz", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    // Automatic fetch spans persist url.full, and the sign-in callback carries a one-time
    // authorization code in its query. Keep structured logs; do not trace request URLs.
    "traces": { "enabled": false }
  },
  "durable_objects": {
    "bindings": [
      { "name": "BROKER_GATE", "class_name": "BrokerGate" },
      { "name": "MARKET_FEED", "class_name": "MarketFeed" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MarketFeed"] },
    { "tag": "v2", "new_sqlite_classes": ["DanAgent"] },
    { "tag": "v3", "new_sqlite_classes": ["BrokerGate"] },
    { "tag": "v4", "deleted_classes": ["DanAgent"] }
  ],
  // Cited pages are read through Browser Run so a recorded catalyst or evidence card is bound
  // to text this Worker retained, rather than to a page the model reports having opened
  // somewhere we cannot see.
  "browser": { "binding": "BROWSER" },
  "secrets_store_secrets": [
    {
      "binding": "EXA_API_KEY",
      "store_id": "a436a6cefedc4acd8bb920cdbc202c1c",
      "secret_name": "exa"
    },
    {
      // Store-backed rather than a per-Worker secret: a Secrets Store entry binds to any
      // Worker by name, so renaming or recreating this Worker never asks a human to retype
      // the credential. Its client id is the `GOOGLE_CLIENT_ID` var below.
      "binding": "GOOGLE_CLIENT_SECRET",
      "store_id": "a436a6cefedc4acd8bb920cdbc202c1c",
      "secret_name": "google-client-secret"
    },
    {
      "binding": "TASTYTRADE_CLIENT_SECRET",
      "store_id": "a436a6cefedc4acd8bb920cdbc202c1c",
      "secret_name": "tastytrade-client-secret"
    },
    {
      "binding": "TASTYTRADE_REFRESH_TOKEN",
      "store_id": "a436a6cefedc4acd8bb920cdbc202c1c",
      "secret_name": "tastytrade-refresh-token"
    },
    {
      // Spice's tastytrade OAuth app, which members connect through. Not the market-data grant
      // above: that one is the Worker's own account, and this one only ever mints tokens from a
      // refresh token a member presents (`src/server/tastytrade-member-grant.ts`). Its client id
      // is the `TASTYTRADE_OAUTH_CLIENT_ID` var below.
      "binding": "TASTYTRADE_OAUTH_CLIENT_SECRET",
      "store_id": "a436a6cefedc4acd8bb920cdbc202c1c",
      "secret_name": "tastytrade-oauth-client-secret"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      // Keeps the pre-rebrand name because D1 cannot rename a database, and the binding
      // resolves by id regardless. Renaming it here would point at a database that does not
      // exist. `migrations/0001_spice.sql` stays for the same shape of reason: D1 records
      // applied migrations by filename, so renaming it would re-apply the initial schema.
      "database_name": "spice-production",
      "database_id": "e45e35cc-bd01-4e29-8940-b5d2ef5e840c",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    // 13:30 UTC is 09:30 EDT; 14:30 UTC is 09:30 EST. The year-candle job runs only at the
    // Eastern cash open, so the off-season fire is a no-op. The lease and unresolved-instrument sweeps still run both times.
    "crons": ["30 13,14 * * 1-5"]
  },
  "vars": {
    "AUTH_BASE_URL": "https://spicy.trade",
    // Public, like the tastytrade client id below: Google puts it in every sign-in URL. Only the
    // client secret is private, so only it is a Secrets Store binding.
    "GOOGLE_CLIENT_ID": "890440130563-5p7tuhn68bmbo6bhckc0jsdo573u3ce7.apps.googleusercontent.com",
    "TASTYTRADE_API_BASE": "https://api.tastyworks.com",
    // A var, not a secret: the client id is public, in every consent URL this Worker issues, and
    // versioning it here keeps it beside the redirect URI it was registered with. The client
    // secret is what must stay private, so it is the Secrets Store binding above. Empty or
    // whitespace reads as missing and closes the connect endpoints with a 503.
    "TASTYTRADE_OAUTH_CLIENT_ID": "4053389c-831d-47b1-9001-b21c6ad9e2f0"
  }
}
