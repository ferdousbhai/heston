{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spice",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "durable_objects": {
    "bindings": [
      { "name": "MARKET_FEED", "class_name": "MarketFeed" },
      { "name": "DanAgent", "class_name": "DanAgent" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MarketFeed"] },
    { "tag": "v2", "new_sqlite_classes": ["DanAgent"] }
  ],
  "ai": { "binding": "AI" },
  "secrets_store_secrets": [
    {
      "binding": "REDDIT_CLIENT_ID",
      "store_id": "a436a6cefedc4acd8bb920cdbc202c1c",
      "secret_name": "reddit-client-id"
    },
    {
      "binding": "REDDIT_CLIENT_SECRET",
      "store_id": "a436a6cefedc4acd8bb920cdbc202c1c",
      "secret_name": "reddit-client-secret"
    },
    {
      "binding": "TASTYTRADE_CLIENT_SECRET",
      "store_id": "a436a6cefedc4acd8bb920cdbc202c1c",
      "secret_name": "tastytrade-client-secret"
    },
    {
      "binding": "TASTYTRADE_REFRESH_TOKEN",
      "store_id": "a436a6cefedc4acd8bb920cdbc202c1c",
      "secret_name": "tastytrade-refresh-token"
    },
    {
      "binding": "XAI_API_KEY",
      "store_id": "a436a6cefedc4acd8bb920cdbc202c1c",
      "secret_name": "xai"
    },
    {
      "binding": "AI_GATEWAY_TOKEN",
      "store_id": "a436a6cefedc4acd8bb920cdbc202c1c",
      "secret_name": "account-ai-gateway"
    },
    {
      "binding": "AUTH_OWNER_EMAIL",
      "store_id": "a436a6cefedc4acd8bb920cdbc202c1c",
      "secret_name": "spice-auth-owner-email"
    },
    {
      "binding": "BETTER_AUTH_SECRET",
      "store_id": "a436a6cefedc4acd8bb920cdbc202c1c",
      "secret_name": "spice-better-auth-secret"
    },
    {
      "binding": "GOOGLE_CLIENT_ID",
      "store_id": "a436a6cefedc4acd8bb920cdbc202c1c",
      "secret_name": "spice-google-client-id"
    },
    {
      "binding": "GOOGLE_CLIENT_SECRET",
      "store_id": "a436a6cefedc4acd8bb920cdbc202c1c",
      "secret_name": "spice-google-client-secret"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spice",
      "database_id": "156976db-742c-4407-8ec0-57c38add05c4",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["30 13,14,22,23 * * 1-5"]
  },
  "vars": {
    "APP_MODE": "live",
    "AUTH_BASE_URL": "https://spice.ferdousbd.workers.dev",
    "TASTYTRADE_API_BASE": "https://api.tastyworks.com"
  }
}
