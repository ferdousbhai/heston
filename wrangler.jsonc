{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "heston",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "workers_dev": false,
  "preview_urls": true,
  // The retired tryspice.xyz pair still routes here so `canonicalHostRedirect` can 308 it to
  // heston.io; drop both entries when the zone is allowed to lapse.
  "routes": [
    { "pattern": "heston.io", "custom_domain": true },
    { "pattern": "www.heston.io", "custom_domain": true },
    { "pattern": "tryspice.xyz", "custom_domain": true },
    { "pattern": "www.tryspice.xyz", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    // Automatic fetch spans persist url.full, and the sign-in callback carries a one-time
    // authorization code in its query. Keep structured logs; do not trace request URLs.
    "traces": { "enabled": false }
  },
  "durable_objects": {
    "bindings": [
      { "name": "BROKER_GATE", "class_name": "BrokerGate" },
      { "name": "MARKET_FEED", "class_name": "MarketFeed" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MarketFeed"] },
    { "tag": "v2", "new_sqlite_classes": ["DanAgent"] },
    { "tag": "v3", "new_sqlite_classes": ["BrokerGate"] },
    { "tag": "v4", "deleted_classes": ["DanAgent"] }
  ],
  // Cited pages are read through Browser Run so the brief is bound to text this Worker
  // retained, rather than to a page the model reports having opened somewhere we cannot see.
  "browser": { "binding": "BROWSER" },
  "secrets_store_secrets": [
    {
      "binding": "EXA_API_KEY",
      "store_id": "a436a6cefedc4acd8bb920cdbc202c1c",
      "secret_name": "exa"
    },
    {
      // Store-backed rather than a per-Worker secret: a Secrets Store entry binds to any
      // Worker by name, so renaming or recreating this Worker never asks a human to retype
      // the credential. `GOOGLE_CLIENT_ID` stays a plain secret because it is not one.
      "binding": "GOOGLE_CLIENT_SECRET",
      "store_id": "a436a6cefedc4acd8bb920cdbc202c1c",
      "secret_name": "google-client-secret"
    },
    {
      "binding": "TASTYTRADE_CLIENT_SECRET",
      "store_id": "a436a6cefedc4acd8bb920cdbc202c1c",
      "secret_name": "tastytrade-client-secret"
    },
    {
      "binding": "TASTYTRADE_REFRESH_TOKEN",
      "store_id": "a436a6cefedc4acd8bb920cdbc202c1c",
      "secret_name": "tastytrade-refresh-token"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      // Keeps the pre-rebrand name because D1 cannot rename a database, and the binding
      // resolves by id regardless. Renaming it here would point at a database that does not
      // exist. `migrations/0001_spice.sql` stays for the same shape of reason: D1 records
      // applied migrations by filename, so renaming it would re-apply the initial schema.
      "database_name": "spice-production",
      "database_id": "e45e35cc-bd01-4e29-8940-b5d2ef5e840c",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    // 13:30 UTC is 09:30 EDT; 14:30 UTC is 09:30 EST. The year-candle job runs only at the
    // Eastern cash open, so the off-season fire is a no-op. Lease sweep still runs both times.
    "crons": ["30 13,14 * * 1-5"]
  },
  "vars": {
    "AUTH_BASE_URL": "https://heston.io",
    "TASTYTRADE_API_BASE": "https://api.tastyworks.com"
  }
}
