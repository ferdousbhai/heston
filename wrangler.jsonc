{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spice",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    { "pattern": "tryspice.xyz", "custom_domain": true },
    { "pattern": "www.tryspice.xyz", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    // Automatic fetch spans persist url.full, and the sign-in callback carries a one-time
    // authorization code in its query. Keep structured logs; do not trace request URLs.
    "traces": { "enabled": false }
  },
  "durable_objects": {
    "bindings": [
      { "name": "BROKER_GATE", "class_name": "BrokerGate" },
      { "name": "MARKET_FEED", "class_name": "MarketFeed" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MarketFeed"] },
    { "tag": "v2", "new_sqlite_classes": ["DanAgent"] },
    { "tag": "v3", "new_sqlite_classes": ["BrokerGate"] },
    { "tag": "v4", "deleted_classes": ["DanAgent"] }
  ],
  // Cited pages are read through Browser Run so the brief is bound to text this Worker
  // retained, rather than to a page the model reports having opened somewhere we cannot see.
  "browser": { "binding": "BROWSER" },
  "secrets_store_secrets": [
    {
      "binding": "EXA_API_KEY",
      "store_id": "a436a6cefedc4acd8bb920cdbc202c1c",
      "secret_name": "exa"
    },
    {
      "binding": "REDDIT_CLIENT_ID",
      "store_id": "a436a6cefedc4acd8bb920cdbc202c1c",
      "secret_name": "reddit-client-id"
    },
    {
      "binding": "REDDIT_CLIENT_SECRET",
      "store_id": "a436a6cefedc4acd8bb920cdbc202c1c",
      "secret_name": "reddit-client-secret"
    },
    {
      "binding": "TASTYTRADE_CLIENT_SECRET",
      "store_id": "a436a6cefedc4acd8bb920cdbc202c1c",
      "secret_name": "tastytrade-client-secret"
    },
    {
      "binding": "TASTYTRADE_REFRESH_TOKEN",
      "store_id": "a436a6cefedc4acd8bb920cdbc202c1c",
      "secret_name": "tastytrade-refresh-token"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spice-production",
      "database_id": "e45e35cc-bd01-4e29-8940-b5d2ef5e840c",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["30 13,14 * * 1-5"]
  },
  "vars": {
    "AUTH_BASE_URL": "https://tryspice.xyz",
    "TASTYTRADE_API_BASE": "https://api.tastyworks.com"
  }
}
