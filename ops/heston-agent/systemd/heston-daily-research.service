# Invoke the owner's agent for today's brief if one does not already exist.
# The Worker never produces a brief; this unit just starts the same agent a
# member would ask by hand. Enable with the timer:
#   cp ops/heston-agent/systemd/heston-daily-research.* ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now heston-daily-research.timer
[Unit]
Description=Heston daily research (if today's brief is missing)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=%h/github.com/ferdousbhai/heston/ops/heston-agent/daily-research.mjs
# A research run reads pages and publishes; it is not a hung process at 15 minutes.
TimeoutStartSec=45min
# Follow the login session so the keyring the proxy reads is the same one.
NoNewPrivileges=true
PrivateTmp=true
Environment=PATH=%h/.local/bin:%h/.grok/bin:/usr/bin
